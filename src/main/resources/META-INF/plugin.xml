<idea-plugin>
    <id>in.srikanthk.devlabs.karate-chop-debugger</id>

    <name>Karate Chop Debugger</name>

    <vendor url="https://devlab.srikanthk.in">Srikanth Iyengar</vendor>

    <description><![CDATA[
  Karate Chop Debugger is an unofficial IntelliJ plugin that makes debugging Karate test cases a lot easier.

  Set breakpoints directly in your <code>.feature</code> files, run tests in debug mode, and inspect variables on the fly — all from the comfort of your IDE. No more scanning logs line by line to figure out what went wrong.

  With this plugin, you can:
  • Add breakpoints with a simple right-click / through shortcut
  • View live variables and responses when a breakpoint is hit
  • Jump straight to the lines being executed
  • Seamlessly work with your existing Karate projects

  <br/><br/>
  This is an <b>unofficial community plugin</b> and is not affiliated with the Karate project or its maintainers.

  <br/><br/>
  Whether you're debugging a flaky test or just want more visibility — this plugin is here to help you work smarter.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>com.intellij.modules.json</depends>
    <extensions defaultExtensionNs="com.intellij">
        <xdebugger.breakpointType implementation="in.srikanthk.devlabs.kchopdebugger.language.KarateDebugStepPoint" />
        <lang.commenter language="karate-dsl" implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateCommenter" />
        <lang.foldingBuilder
                language="karate-dsl"
                implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateCodeFoldingBuilder"
        />
        <toolWindow factoryClass="in.srikanthk.devlabs.kchopdebugger.ui.DebugToolWindowFactory"
                    id="Karate Chop Debugger" secondary="true" anchor="bottom"
                    icon="AllIcons.Toolwindows.ToolWindowInspection"/>
        <codeInsight.lineMarkerProvider language="karate-dsl"
                                  implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateRunLineMarkerContributor"
                                  />
        <applicationService
                serviceImplementation="in.srikanthk.devlabs.kchopdebugger.configuration.KarateDebuggerConfiguration"/>
        <applicationConfigurable
                parentId="tools"
                instance="in.srikanthk.devlabs.kchopdebugger.ui.AppSettingsConfigurable"
                id="org.intellij.sdk.settings.AppSettingsConfigurable"
                displayName="Karate Chop Debugger Preference"/>
            <notificationGroup id="Karate Chop Debugger Notification"
                               displayType="BALLOON"
                               isLogByDefault="true"/>
        <fileType name="Karate DSL"
                  implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateLanguageFileType"
                  fieldName="INSTANCE"
                  language="karate-dsl"
                  extensions="feature"/>
        <lang.parserDefinition
                language="karate-dsl"
                implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="karate-dsl"
                implementationClass="in.srikanthk.devlabs.kchopdebugger.language.KarateSyntaxHighlighterFactory"/>
        <multiHostInjector
                implementation="in.srikanthk.devlabs.kchopdebugger.language.annotator.injector.KarateDocStringInjector"/>
        <annotator language="karate-dsl"
                   implementationClass="in.srikanthk.devlabs.kchopdebugger.language.annotator.KarateStepAnnotator"
        />
        <annotator language="karate-dsl"
                   implementationClass="in.srikanthk.devlabs.kchopdebugger.language.annotator.KarateDescriptionAnnotator"
        />
        <enterHandlerDelegate implementation="in.srikanthk.devlabs.kchopdebugger.language.KarateEnterHandler" order="first"/>
    </extensions>
    <projectListeners>
        <listener class="in.srikanthk.devlabs.kchopdebugger.listener.KarateBreakpointListener"
                  topic="com.intellij.xdebugger.breakpoints.XBreakpointListener"/>
    </projectListeners>

    <actions>
        <action id="in.srikanthk.devlabs.kchopdebugger.action.DebugTestAction"
                class="in.srikanthk.devlabs.kchopdebugger.action.DebugTestAction" text="Debug Test" icon="AllIcons.Actions.StartDebugger">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut first-keystroke="shift F9" keymap="$default" />
        </action>
        <action id="in.srikanthk.devlabs.kchopdebugger.action.RunTestAction"
                class="in.srikanthk.devlabs.kchopdebugger.action.RunTestAction" text="Run Test" icon="AllIcons.Actions.Execute">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut first-keystroke="shift F10" keymap="$default" />
        </action>
        <action id="in.srikanthk.devlabs.kchopdebugger.action.StepIntoAction"
                class="in.srikanthk.devlabs.kchopdebugger.action.StepIntoAction" text="Step Into">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <keyboard-shortcut first-keystroke="F7" keymap="$default" />
        </action>
        <action id="in.srikanthk.devlabs.kchopdebugger.action.StepOverAction"
                class="in.srikanthk.devlabs.kchopdebugger.action.StepOverAction" text="Step Over" icon="AllIcons.Actions.StartDebugger">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <keyboard-shortcut first-keystroke="F8" keymap="$default" />
        </action>
        <action id="in.srikanthk.devlabs.kchopdebugger.action.QuickFillEvalExpression"
                class="in.srikanthk.devlabs.kchopdebugger.action.QuickFillEvalExpression" text="Fill Eval Expr">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F8"/>
        </action>
    </actions>
</idea-plugin>
